<Window x:Class="FolderSync.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="660" SizeToContent="Height" MinHeight="440"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="Heading" Style="{StaticResource H1}" FontSize="20"/>
        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,16"
                   Text="Choose the two folders and how they should be kept in step."/>

        <!-- Folders -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,0,12,10"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Left folder" Margin="0,0,12,10"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="LeftBox" Margin="0,0,8,10"
                           TextChanged="Path_Changed"/>
                <Button    Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="0,0,0,10"
                           Click="BrowseLeft_Click"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Right folder" Margin="0,0,12,0"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="RightBox" Margin="0,0,8,0"
                           TextChanged="Path_Changed"/>
                <Button    Grid.Row="2" Grid.Column="2" Content="Browse…" Click="BrowseRight_Click"/>
            </Grid>
        </Border>

        <!-- Direction -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Sync type" Style="{StaticResource CardTitle}"/>
                <ComboBox x:Name="DirectionBox" Width="260" HorizontalAlignment="Left"
                          SelectionChanged="Direction_Changed">
                    <ComboBoxItem Content="Left → Right"/>
                    <ComboBoxItem Content="Right → Left"/>
                    <ComboBoxItem Content="Two-way"/>
                </ComboBox>
                <TextBlock x:Name="DirectionHelp" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>

                <CheckBox x:Name="MirrorCheck" Margin="0,14,0,0" Click="Mirror_Changed"
                          Content="Mirror — make the receiving folder an exact copy (deletions carry over)"/>
                <TextBlock x:Name="MirrorHelp" Style="{StaticResource Subtle}" Margin="27,6,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Style="{StaticResource Subtle}"
                   Foreground="{DynamicResource Bad}" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}"
                    Margin="0" MinWidth="92" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
