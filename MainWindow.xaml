<Window x:Class="FolderSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderSync"
        Title="Folder Sync" Height="760" Width="1080"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- How something is doing, as a colour. Each expects a "Health" property (a PairHealth) on
             its data, except HealthCellText's twin for the pairs grid, which reads LastRunHealth. -->
        <Style x:Key="HealthDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource ControlBorder}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static local:PairHealth.Ok}">
                    <Setter Property="Fill" Value="{DynamicResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static local:PairHealth.Warn}">
                    <Setter Property="Fill" Value="{DynamicResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static local:PairHealth.Bad}">
                    <Setter Property="Fill" Value="{DynamicResource Bad}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DaySquare" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBorder}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static local:PairHealth.Ok}">
                    <Setter Property="Background" Value="{DynamicResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static local:PairHealth.Warn}">
                    <Setter Property="Background" Value="{DynamicResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static local:PairHealth.Bad}">
                    <Setter Property="Background" Value="{DynamicResource Bad}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Coloured text in a grid cell. The last trigger puts it back to white on a selected row,
             where green or red on the accent colour could not be read. -->
        <Style x:Key="HealthCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static local:PairHealth.Ok}">
                    <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static local:PairHealth.Warn}">
                    <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Health}" Value="{x:Static local:PairHealth.Bad}">
                    <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PairStatusCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LastRunHealth}" Value="{x:Static local:PairHealth.Ok}">
                    <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LastRunHealth}" Value="{x:Static local:PairHealth.Warn}">
                    <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LastRunHealth}" Value="{x:Static local:PairHealth.Bad}">
                    <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,12">
                    <TextBlock Text="Folder Sync" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Subtle}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Footer actions pinned to the bottom of the sidebar -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                    <Button x:Name="UpdateBanner" Style="{StaticResource PrimaryButton}"
                            Content="Update available" Visibility="Collapsed"
                            Margin="0,0,0,8" HorizontalAlignment="Stretch"
                            Click="UpdateBanner_Click"/>
                    <Button x:Name="ThemeToggle" Style="{StaticResource LinkButton}"
                            Content="Switch to dark mode" HorizontalAlignment="Left"
                            Click="ThemeToggle_Click"/>
                </StackPanel>

                <ListBox x:Name="Nav" Style="{StaticResource NavList}"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Content="Home" IsSelected="True"/>
                    <ListBoxItem Content="Folder pairs"/>
                    <ListBoxItem Content="Schedule"/>
                    <ListBoxItem Content="History"/>
                    <ListBoxItem Content="Recycled files"/>
                    <ListBoxItem Content="Notifications"/>
                    <ListBoxItem Content="Settings"/>
                    <ListBoxItem Content="About"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Content ===================== -->
        <!-- Horizontal scrolling stays disabled on purpose: it would measure the content with
             unbounded width, which collapses the star-sized DataGrid columns. Cards therefore
             follow the window width, and the grids scroll internally when narrow. -->
        <!-- No focus rectangle: it would be a dotted line round the whole page, which says nothing. -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,24,28,24"
                      FocusVisualStyle="{x:Null}">
            <!-- The content follows the window up to a readable width and then stops, keeping to the
                 left: on a maximised window a sentence would otherwise run the full width of the screen. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1180*" MaxWidth="1180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">

                <!-- ============ PAGE: Home ============ -->
                <StackPanel x:Name="PageHome">
                    <TextBlock Text="Home" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,18"
                               Text="How your folder pairs are doing, and one button to sync them."/>

                    <!-- Status and the actions -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="HomeDot" Grid.Column="0" Width="14" Height="14" Margin="2,7,14,0"
                                         VerticalAlignment="Top" Fill="{DynamicResource ControlBorder}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="HomeHeadline" FontSize="19" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Text="Checking…"/>
                                    <TextBlock x:Name="HomeSubline" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="SyncButton" Style="{StaticResource PrimaryButton}"
                                        Content="Sync now" Click="Sync_Click"/>
                                <Button x:Name="PreviewButton" Content="Preview" Click="Preview_Click"
                                        ToolTip="Show what a sync would copy and remove, without changing anything."/>
                                <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click"/>
                                <Button x:Name="HealthButton" Content="Check health" Click="Health_Click"/>
                                <Button Content="Open logs" Style="{StaticResource LinkButton}" Click="OpenLogs_Click"/>
                            </StackPanel>
                            <ProgressBar x:Name="Progress" Margin="0,16,0,0" IsIndeterminate="True"
                                         Minimum="0" Maximum="100" Visibility="Collapsed"/>
                            <TextBlock x:Name="StatusText" Margin="0,12,0,0" Text="Ready." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Shown instead of the pair cards on a fresh install -->
                    <Border x:Name="HomeEmptyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="No folder pairs yet" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Subtle}"
                                       Text="A folder pair is two folders and a rule for keeping them in step. Set one up and it appears here."/>
                            <Button Content="Set up a folder pair" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,14,0,0" Click="GoToPairs_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- One card per pair -->
                    <ItemsControl x:Name="HomePairs" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="12" Height="12" Margin="2,5,14,0"
                                                 VerticalAlignment="Top" Style="{StaticResource HealthDot}"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Mode, Mode=OneWay}" Style="{StaticResource Subtle}" Margin="10,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Route, Mode=OneWay}" Style="{StaticResource Subtle}"
                                                       Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Route, Mode=OneWay}"/>
                                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding Headline, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding Detail, Mode=OneWay}"/>
                                                <Run Text="{Binding Space, Mode=OneWay}" Foreground="{DynamicResource FgMuted}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- Only for a mirror the deletion guard stopped -->
                                        <Button Grid.Column="2" Content="Review…" VerticalAlignment="Center" Margin="14,0,0,0"
                                                Tag="{Binding Key, Mode=OneWay}"
                                                Visibility="{Binding ReviewVisibility, Mode=OneWay}"
                                                ToolTip="See what this mirror would delete, and approve it if that is right."
                                                Click="ReviewPair_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The last 30 days, one square per day -->
                    <Border Style="{StaticResource Card}" Margin="0,4,0,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Last 30 days" Style="{StaticResource CardTitle}"/>
                                <Button Content="View history" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0"
                                        Click="GoToHistory_Click"/>
                            </Grid>
                            <ItemsControl x:Name="HomeDays" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="26" Margin="1.5,0" CornerRadius="3"
                                                Style="{StaticResource DaySquare}"
                                                ToolTip="{Binding Tooltip, Mode=OneWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource Subtle}" Text="30 days ago"/>
                                <TextBlock Style="{StaticResource Subtle}" Text="Today" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="HomeMonthText" Style="{StaticResource Subtle}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ PAGE: Folder pairs ============ -->
                <StackPanel x:Name="PageSync" Visibility="Collapsed">
                    <TextBlock Text="Folder pairs" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,18" TextWrapping="Wrap"
                               Text="Each folder pair keeps two folders in step — on this PC, on a USB or network drive, or in cloud storage that appears as a folder."/>

                    <!-- Folder pairs -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <!-- Virtualisation off: only a handful of pairs, and recycled row
                                 containers are what let cell editors write stale values back. -->
                            <DataGrid x:Name="PairGrid" MinHeight="130" MaxHeight="300"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      EnableRowVirtualization="False" EnableColumnVirtualization="False"
                                      IsReadOnly="True"
                                      SelectionChanged="PairGrid_SelectionChanged"
                                      MouseDoubleClick="PairGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <!-- Only "On" is editable in the grid; everything else is set
                                         in the pair dialog, so there is no cell-editor to misfire. -->
                                    <DataGridTemplateColumn Header="On" Width="50" SortMemberPath="Enabled">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Include this pair when syncing."/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Template columns throughout, so long text ends in an ellipsis and the
                                         full value is one hover away, rather than being cut off mid-word. -->
                                    <DataGridTemplateColumn Header="Name" Width="*" MinWidth="100" SortMemberPath="DisplayName">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}" Style="{StaticResource CellText}"
                                                           ToolTip="{Binding DisplayName, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Last sync" Width="145" SortMemberPath="LastRunText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LastRunText, Mode=OneWay}" Style="{StaticResource PairStatusCellText}"
                                                           ToolTip="{Binding LastRunText, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Left folder" Width="2*" MinWidth="130" SortMemberPath="Left">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Left, Mode=OneWay}" Style="{StaticResource CellText}"
                                                           ToolTip="{Binding Left, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- The direction sits between the two folders it joins. -->
                                    <DataGridTemplateColumn Header="" Width="44" CanUserSort="False" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Arrow, Mode=OneWay}" Style="{StaticResource CellText}"
                                                           FontSize="16" HorizontalAlignment="Center"
                                                           ToolTip="{Binding Summary, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Right folder" Width="2*" MinWidth="130" SortMemberPath="Right">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Right, Mode=OneWay}" Style="{StaticResource CellText}"
                                                           ToolTip="{Binding Right, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Mode" Width="158" SortMemberPath="ModeDetail">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ModeDetail, Mode=OneWay}" Style="{StaticResource CellText}"
                                                           ToolTip="{Binding ModeDetail, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Add pair…" Style="{StaticResource PrimaryButton}" Click="AddPair_Click"/>
                                <Button x:Name="EditPairButton" Content="Edit" IsEnabled="False" Click="EditPair_Click"/>
                                <Button x:Name="RemovePairButton" Content="Remove" IsEnabled="False" Click="RemovePair_Click"/>
                                <Button Content="Open config file" Style="{StaticResource LinkButton}" Click="OpenConfig_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="RecycleNote" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Cloud services already mounted as folders: the no-sign-in route. Folded to one
                         line once pairs exist, so it stops pushing the pairs down the page. -->
                    <Border x:Name="MountedCloudCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Cloud storage found on this PC" Style="{StaticResource CardTitle}" Margin="0"/>
                                <Button x:Name="CloudToggle" Content="Show" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0"
                                        Click="CloudToggle_Click"/>
                            </Grid>
                            <TextBlock x:Name="CloudSummary" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>

                            <StackPanel x:Name="CloudDetails" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,12" TextWrapping="Wrap"
                                           Text="These services already put your files in an ordinary folder, so Folder Sync can copy straight to them — no sign-in, no sharing limits, and much faster than going through the provider's API."/>

                                <ItemsControl x:Name="MountedCloudList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ControlBg}"
                                                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                                    CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" FontSize="14"/>
                                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Subtle}" Margin="10,0,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Subtle}"
                                                                   Margin="0,4,12,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <!-- OneWay: these are computed, read-only properties. -->
                                                    <Button Grid.Column="1" VerticalAlignment="Center"
                                                            Content="Sync to this…" Tag="{Binding Path}"
                                                            Visibility="{Binding ButtonVisibility, Mode=OneWay}"
                                                            Click="SyncToMountedCloud_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="MoreProvidersText" Style="{StaticResource Subtle}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Add another cloud service later and it will appear here on its own — sign in to its desktop app and the folder it creates is picked up automatically, with nothing to set up in Folder Sync."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Skip lists -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Files and folders to skip (all pairs)" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Files" Margin="0,0,12,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SkipFilesBox" Margin="0,0,0,8"
                                         LostFocus="Skip_LostFocus"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Folders" Margin="0,0,12,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SkipFoldersBox" LostFocus="Skip_LostFocus"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0"
                                       Text="Separate with ; or , — wildcards allowed (e.g. ~$*, *.tmp)."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ PAGE: Schedule ============ -->
                <StackPanel x:Name="PageSchedule" Visibility="Collapsed">
                    <TextBlock Text="Schedule" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,18"
                               Text="Windows Task Scheduler runs the sync for you. No admin rights required."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel x:Name="ScheduleRows"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,10,0,0"
                                       Text="Times use the 24-hour clock. Changing a time takes effect when you press Enable again."/>
                            <TextBlock x:Name="ScheduleSeparateNote" Style="{StaticResource Subtle}" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Warn}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Logon and unlock" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="UnlockNote" Style="{StaticResource Subtle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="When files change" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="ScheduleWatchNote" Style="{StaticResource Subtle}"/>
                            <Button Content="Open Settings" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                    Margin="-6,6,0,0" Click="GoToSettings_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ PAGE: History ============ -->
                <StackPanel x:Name="PageHistory" Visibility="Collapsed">
                    <TextBlock Text="History" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,18"
                               Text="Every sync: when it ran, what started it, and what it changed."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Runs" Style="{StaticResource CardTitle}" Margin="0,0,18,0"/>
                                    <CheckBox x:Name="HistoryOnlyChanges" Content="Hide runs with nothing to report"
                                              ToolTip="Hide runs that finished without errors and found nothing to copy or remove."
                                              Checked="HistoryFilter_Click" Unchecked="HistoryFilter_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="HistoryExportButton" Content="Export to CSV…" Click="HistoryExport_Click"/>
                                    <Button x:Name="HistoryRefreshButton" Content="Refresh" Style="{StaticResource LinkButton}"
                                            Margin="0" Click="HistoryRefresh_Click"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="HistoryGrid" MinHeight="150" MaxHeight="290" IsReadOnly="True"
                                      SelectionChanged="HistoryGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <!-- Sized to fit the window at its default width with nothing cut off. What a
                                         run recycled and kept is in the details below, pair by pair. -->
                                    <DataGridTextColumn Header="When" Binding="{Binding WhenText, Mode=OneWay}" Width="142"/>
                                    <DataGridTextColumn Header="Started by" Binding="{Binding TriggerText, Mode=OneWay}" Width="130"/>
                                    <DataGridTextColumn Header="Took" Binding="{Binding DurationText, Mode=OneWay}" Width="100"/>
                                    <DataGridTemplateColumn Header="Result" Width="130" SortMemberPath="ResultText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ResultText, Mode=OneWay}" Style="{StaticResource HealthCellText}"
                                                           ToolTip="{Binding ResultText, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Copied" Binding="{Binding FilesCopied, Mode=OneWay}" Width="80"/>
                                    <DataGridTextColumn Header="Failed" Binding="{Binding FilesFailed, Mode=OneWay}" Width="72"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="*" MinWidth="70" SortMemberPath="BytesCopied"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="HistoryStatus" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="HistoryDetailTitle" Text="Run details" Style="{StaticResource CardTitle}"/>
                                <Button x:Name="HistoryOpenLogButton" Content="Open log" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0"
                                        IsEnabled="False" Click="HistoryOpenLog_Click"/>
                            </Grid>
                            <TextBlock x:Name="HistoryDetailNote" Style="{StaticResource Subtle}" Margin="0,0,0,10"
                                       Text="Select a run above to see what it did."/>
                            <DataGrid x:Name="HistoryPairGrid" MaxHeight="180" IsReadOnly="True" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pair" Binding="{Binding Name, Mode=OneWay}" Width="150"/>
                                    <DataGridTemplateColumn Header="Result" Width="100" SortMemberPath="ResultText">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ResultText, Mode=OneWay}" Style="{StaticResource HealthCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Copied" Binding="{Binding FilesCopied, Mode=OneWay}" Width="80"/>
                                    <DataGridTextColumn Header="Failed" Binding="{Binding FilesFailed, Mode=OneWay}" Width="72"/>
                                    <DataGridTextColumn Header="Recycled" Binding="{Binding FilesRecycled, Mode=OneWay}" Width="94"/>
                                    <DataGridTextColumn Header="Kept" Binding="{Binding FilesBackedUp, Mode=OneWay}" Width="66"
                                                        ToolTipService.ToolTip="Previous versions kept when a changed copy replaced them"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="85"/>
                                    <DataGridTemplateColumn Header="Note" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Note, Mode=OneWay}" Style="{StaticResource CellText}"
                                                           ToolTip="{Binding Note, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="HistoryChangeTitle" Text="What changed" FontWeight="SemiBold"
                                       Margin="0,16,0,8" Visibility="Collapsed"/>
                            <DataGrid x:Name="HistoryChangeGrid" MinHeight="110" MaxHeight="280" IsReadOnly="True"
                                      Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="What" Binding="{Binding What, Mode=OneWay}" Width="230"/>
                                    <DataGridTemplateColumn Header="File" Width="2*" SortMemberPath="File">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding File, Mode=OneWay}" Style="{StaticResource CellText}"
                                                           ToolTip="{Binding File, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="90" SortMemberPath="Size"/>
                                    <DataGridTextColumn Header="Pair" Binding="{Binding Pair, Mode=OneWay}" Width="130"/>
                                    <DataGridTemplateColumn Header="In folder" Width="*" SortMemberPath="Into">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Into, Mode=OneWay}" Style="{StaticResource CellText}"
                                                           ToolTip="{Binding Into, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="HistoryChangeNote" Style="{StaticResource Subtle}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ PAGE: Recycled files ============ -->
                <StackPanel x:Name="PageRecycled" Visibility="Collapsed">
                    <TextBlock Text="Recycled files" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,18"
                               Text="When a mirror would delete something, it is moved here instead — and so is the version a changed file replaces, for pairs that keep versions. Restore puts files back into the folder they came from, so the next sync copies them across again."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Batches" Style="{StaticResource CardTitle}" Margin="0,0,12,0"/>
                                <Button x:Name="RefreshRecycledButton" Content="Refresh" Style="{StaticResource LinkButton}" Click="RefreshRecycled_Click"/>
                            </StackPanel>
                            <DataGrid x:Name="BatchGrid" MinHeight="110" MaxHeight="200" IsReadOnly="True"
                                      SelectionChanged="BatchGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When" Binding="{Binding WhenText, Mode=OneWay}" Width="145"/>
                                    <DataGridTextColumn Header="Why" Binding="{Binding ReasonText, Mode=OneWay}" Width="180"/>
                                    <DataGridTextColumn Header="Destination" Binding="{Binding DestinationName, Mode=OneWay}" Width="150"/>
                                    <DataGridTextColumn Header="Files" Binding="{Binding FileCount, Mode=OneWay}" Width="60"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="80"/>
                                    <DataGridTemplateColumn Header="Folder" Width="*" SortMemberPath="Path">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Path, Mode=OneWay}" Style="{StaticResource CellText}"
                                                           ToolTip="{Binding Path, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="RecycledFilesTitle" Text="Files" Style="{StaticResource CardTitle}"/>
                            <!-- Says what restoring this particular batch would do: recovering a
                                 deleted file and rolling back a replaced one are different acts. -->
                            <TextBlock x:Name="RestoreMeaningText" Style="{StaticResource Subtle}"
                                       Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <DataGrid x:Name="RecycledFileGrid" MinHeight="140" MaxHeight="260" IsReadOnly="True"
                                      SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File" Binding="{Binding RelativePath, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="90"/>
                                    <DataGridTextColumn Header="Modified" Binding="{Binding Modified, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="RestoreSelectedButton" Style="{StaticResource PrimaryButton}"
                                        Content="Restore selected" Click="RestoreSelected_Click"/>
                                <Button x:Name="RestoreAllButton" Content="Restore all in batch" Click="RestoreAll_Click"/>
                                <Button Content="Open folder" Style="{StaticResource LinkButton}" Click="OpenBatchFolder_Click"/>
                                <Button x:Name="DeleteBatchButton" Style="{StaticResource DangerButton}"
                                        Content="Delete batch" Click="DeleteBatch_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="RestoreStatus" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ PAGE: Notifications ============ -->
                <StackPanel x:Name="PageEmail" Visibility="Collapsed">
                    <TextBlock Text="Notifications" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,18"
                               Text="Hear about it when a sync goes wrong, without having to open this window."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Windows notifications" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="NotifyFailureCheck" Checked="NotifySetting_Click" Unchecked="NotifySetting_Click"
                                      Content="Tell me when a sync I was not watching fails or is stopped"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <CheckBox x:Name="OverdueCheck" Checked="NotifySetting_Click" Unchecked="NotifySetting_Click"
                                          Content="Warn me when a pair has not synced successfully for"/>
                                <ComboBox x:Name="OverdueDaysBox" Width="74" Margin="10,0,8,0"
                                          SelectionChanged="NotifySetting_Changed"/>
                                <TextBlock Text="days"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,12,0,0"
                                       Text="Notifications come from the Folder Sync icon next to the clock. A scheduled sync can only show one for a few seconds; when Folder Sync is running (it can start with Windows — see Settings) they stay in the notification list."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Email" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="EmailEnable" Content="Send email about scheduled syncs"
                                      Checked="EmailEnable_Click" Unchecked="EmailEnable_Click"/>
                            <StackPanel x:Name="EmailFields" Margin="0,16,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="From" Margin="0,0,14,10"/>
                                    <TextBox  Grid.Row="0" Grid.Column="1" x:Name="EmailFrom" Margin="0,0,0,10"
                                              LostFocus="Email_LostFocus"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="App password" Margin="0,0,14,10"/>
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- PasswordBox has no placeholder, so an overlay shows
                                             whether a password is already stored. -->
                                        <Grid Grid.Column="0">
                                            <PasswordBox x:Name="EmailPassword" LostFocus="Email_LostFocus"
                                                         PasswordChanged="EmailPassword_Changed"/>
                                            <TextBlock x:Name="EmailPasswordHint" IsHitTestVisible="False"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource FgMuted}"/>
                                        </Grid>
                                        <Button Grid.Column="1" Content="How?" Style="{StaticResource LinkButton}"
                                                Margin="8,0,0,0" Click="AppPasswordHelp_Click"/>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Send to" Margin="0,0,14,10"/>
                                    <TextBox  Grid.Row="2" Grid.Column="1" x:Name="EmailTo" Margin="0,0,0,10"
                                              LostFocus="Email_LostFocus"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="SMTP" Margin="0,0,14,10"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBox x:Name="EmailHost" Width="220" LostFocus="Email_LostFocus"/>
                                        <TextBlock Text="Port" Margin="12,0,8,0"/>
                                        <TextBox x:Name="EmailPort" Width="70" LostFocus="Email_LostFocus"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="When" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="EmailModeBox" Width="190" SelectionChanged="EmailMode_Changed">
                                            <ComboBoxItem Content="After every sync"/>
                                            <ComboBoxItem Content="Only on errors"/>
                                            <ComboBoxItem Content="Only on success"/>
                                            <ComboBoxItem Content="Weekly summary"/>
                                        </ComboBox>
                                        <Button Content="Send test email" Margin="12,0,0,0" Click="SendTest_Click"/>
                                        <TextBlock x:Name="EmailStatus" Margin="12,0,0,0" Style="{StaticResource Subtle}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="EmailModeHint" Style="{StaticResource Subtle}" Margin="0,12,0,0"/>
                                <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0"
                                           Text="Gmail needs a 16-character App Password, not your normal password. The password is stored encrypted for your Windows account."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ PAGE: Settings ============ -->
                <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                    <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,18"
                               Text="Everything here saves as you change it."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Automatic sync" Style="{StaticResource CardTitle}"/>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="WatchCheck" Content="Sync when files change, after they have been quiet for"
                                          Checked="WatchSetting_Click" Unchecked="WatchSetting_Click"/>
                                <ComboBox x:Name="WatchDelayBox" Width="118" Margin="10,0,0,0"
                                          SelectionChanged="WatchSetting_Changed"/>
                            </StackPanel>
                            <TextBlock x:Name="WatchStatusText" Style="{StaticResource Subtle}" Margin="27,6,0,0"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="27,3,0,0"
                                       Text="Folder Sync watches the folder each pair copies from. This only works while Folder Sync is running, which is why it can sit in the tray."/>

                            <CheckBox x:Name="StartupCheck" Margin="0,14,0,0" Checked="Startup_Click" Unchecked="Startup_Click"
                                      Content="Start Folder Sync in the tray when I sign in to Windows"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="27,6,0,0"
                                       Text="With either of these on, closing the window keeps Folder Sync running in the tray, next to the clock. Use Exit on the tray icon to stop it."/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="At sign-in and unlock, sync at most once every"/>
                                <ComboBox x:Name="MinGapBox" Width="74" Margin="10,0,8,0" SelectionChanged="Setting_Changed"/>
                                <TextBlock Text="minutes"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Safety" Style="{StaticResource CardTitle}"/>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="RecycleCheck" Content="Keep what a mirror deletes in the recycle folder for"
                                          Checked="Recycle_Click" Unchecked="Recycle_Click"/>
                                <ComboBox x:Name="RecycleDaysBox" Width="74" Margin="10,0,8,0" SelectionChanged="Setting_Changed"/>
                                <TextBlock Text="days"/>
                            </StackPanel>
                            <TextBlock x:Name="RecycleOffWarning" Style="{StaticResource Subtle}" Margin="27,6,0,0"
                                       Foreground="{DynamicResource Bad}" Visibility="Collapsed"
                                       Text="Off: a mirror deletes files for good, and no pair can keep previous versions."/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <CheckBox x:Name="GuardCheck" Content="Stop a mirror that would delete" Checked="Guard_Click" Unchecked="Guard_Click"/>
                                <ComboBox x:Name="GuardPercentBox" Width="74" Margin="10,0,8,0" SelectionChanged="Setting_Changed"/>
                                <TextBlock Text="% or more of the receiving folder, and at least"/>
                                <ComboBox x:Name="GuardMinFilesBox" Width="74" Margin="10,0,8,0" SelectionChanged="Setting_Changed"/>
                                <TextBlock Text="files"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Subtle}" Margin="27,6,0,0"
                                       Text="A deletion that large usually means the sending folder is wrong or not fully available yet. The pair is left untouched, and you can review and approve the deletion from the Home page."/>

                            <CheckBox x:Name="TwoWayKeepCheck" Margin="0,14,0,0" Checked="Setting_Click" Unchecked="Setting_Click"
                                      Content="Two-way pairs: keep the version a newer copy replaces"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="27,6,0,0"
                                       Text="One-directional pairs choose this for themselves, in the pair's own settings (Folder pairs → Edit)."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="History and logs" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Keep the run history for"/>
                                <ComboBox x:Name="HistoryDaysBox" Width="74" Margin="10,0,8,0" SelectionChanged="Setting_Changed"/>
                                <TextBlock Text="days, and each run's log file for"/>
                                <ComboBox x:Name="LogDaysBox" Width="74" Margin="10,0,8,0" SelectionChanged="Setting_Changed"/>
                                <TextBlock Text="days"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Appearance and updates" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Theme"/>
                                <ComboBox x:Name="ThemeBox" Width="170" Margin="10,0,0,0" SelectionChanged="Theme_Changed">
                                    <ComboBoxItem Content="Same as Windows"/>
                                    <ComboBoxItem Content="Light"/>
                                    <ComboBoxItem Content="Dark"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="UpdateCheck" Margin="0,14,0,0" Checked="Setting_Click" Unchecked="Setting_Click"
                                      Content="Check for a new version when Folder Sync starts (at most once a day)"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ PAGE: About ============ -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="About" Style="{StaticResource H1}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="AboutVersion" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Subtle}"
                                       Text="Mirrors one folder into several local cloud-sync folders or backup drives, using robocopy for transfers and Windows Task Scheduler for automation."/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Check for updates" Click="CheckUpdates_Click"/>
                                <Button Content="Open project page" Style="{StaticResource LinkButton}" Click="OpenProject_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Subtle}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Developer / copyright -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Developer" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Developed by" Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Bhoomil Kalyani" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Contact" Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Padding="0,0,0,8" Margin="0"
                                        Content="bhoomil.kalyani999@gmail.com" Click="EmailDeveloper_Click"
                                        ToolTip="Send an email"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Source" Style="{StaticResource Subtle}"/>
                                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Padding="0" Margin="0"
                                        Content="github.com/BhoomilKalyani/FolderSync" Click="OpenProject_Click"/>
                            </Grid>

                            <Separator/>
                            <TextBlock x:Name="CopyrightText" Style="{StaticResource Subtle}"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0"
                                       Text="Released under the MIT Licence. Provided as is, without warranty of any kind."/>
                            <Button Content="View licence" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="ViewLicence_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Where things live on disk -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Folders" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="AboutPaths" Style="{StaticResource Subtle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
