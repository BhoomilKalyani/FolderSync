<Window x:Class="FolderSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderSync"
        Title="Folder Sync" Height="720" Width="1040"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,12">
                    <TextBlock Text="Folder Sync" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Subtle}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Footer actions pinned to the bottom of the sidebar -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                    <Button x:Name="UpdateBanner" Style="{StaticResource PrimaryButton}"
                            Content="Update available" Visibility="Collapsed"
                            Margin="0,0,0,8" HorizontalAlignment="Stretch"
                            Click="UpdateBanner_Click"/>
                    <Button x:Name="ThemeToggle" Style="{StaticResource LinkButton}"
                            Content="Toggle dark mode" HorizontalAlignment="Left"
                            Click="ThemeToggle_Click"/>
                </StackPanel>

                <ListBox x:Name="Nav" Style="{StaticResource NavList}"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Content="Sync" IsSelected="True"/>
                    <ListBoxItem Content="Schedule"/>
                    <ListBoxItem Content="Notifications"/>
                    <ListBoxItem Content="Recycled files"/>
                    <ListBoxItem Content="About"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Content ===================== -->
        <!-- Horizontal scrolling stays disabled on purpose: it would measure the content with
             unbounded width, which collapses the star-sized DataGrid columns. Cards therefore
             follow the window width, and the destinations grid scrolls internally when narrow. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,24,28,24">
            <Grid>

                <!-- ============ PAGE: Sync ============ -->
                <StackPanel x:Name="PageSync">
                    <TextBlock Text="Sync" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,18" TextWrapping="Wrap"
                               Text="Each folder pair keeps two folders in step — on this PC, on a USB or network drive, or in cloud storage that appears as a folder."/>

                    <!-- Cloud services already mounted as folders: the no-sign-in route -->
                    <Border x:Name="MountedCloudCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Cloud storage found on this PC" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,12" TextWrapping="Wrap"
                                       Text="These services already put your files in an ordinary folder, so Folder Sync can copy straight to them — no sign-in, no sharing limits, and much faster than going through the provider's API."/>

                            <ItemsControl x:Name="MountedCloudList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlBg}"
                                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                                CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" FontSize="14"/>
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Subtle}" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Subtle}"
                                                               Margin="0,4,12,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <!-- OneWay: these are computed, read-only properties. -->
                                                <Button Grid.Column="1" VerticalAlignment="Center"
                                                        Content="Sync to this…" Tag="{Binding Path}"
                                                        Visibility="{Binding ButtonVisibility, Mode=OneWay}"
                                                        Click="SyncToMountedCloud_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="MoreProvidersText" Style="{StaticResource Subtle}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Add another cloud service later and it will appear here on its own — sign in to its desktop app and the folder it creates is picked up automatically, with nothing to set up in Folder Sync."/>
                        </StackPanel>
                    </Border>

                    <!-- Folder pairs -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Folder pairs" Style="{StaticResource CardTitle}"/>
                            <!-- Virtualisation off: only a handful of pairs, and recycled row
                                 containers are what let cell editors write stale values back. -->
                            <DataGrid x:Name="PairGrid" MinHeight="130" MaxHeight="260"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      EnableRowVirtualization="False" EnableColumnVirtualization="False"
                                      IsReadOnly="True"
                                      MouseDoubleClick="PairGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <!-- Only "On" is editable in the grid; everything else is set
                                         in the pair dialog, so there is no cell-editor to misfire. -->
                                    <DataGridTemplateColumn Header="On" Width="46" SortMemberPath="Enabled">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="EnabledCheck_Click"
                                                          ToolTip="Include this pair when syncing."/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- OneWay throughout: these are computed, read-only properties and a
                                         DataGridTextColumn binding is TwoWay unless told otherwise. -->
                                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName, Mode=OneWay}" Width="130"/>
                                    <DataGridTextColumn Header="Last run" Binding="{Binding LastRunText, Mode=OneWay}" Width="130"/>
                                    <DataGridTextColumn Header="Sync type" Binding="{Binding DirectionText, Mode=OneWay}" Width="105"/>
                                    <DataGridTextColumn Header="Mode" Binding="{Binding ModeText, Mode=OneWay}" Width="140"/>
                                    <DataGridTextColumn Header="Left folder" Binding="{Binding Left, Mode=OneWay}" Width="*" MinWidth="150"/>
                                    <DataGridTextColumn Header="Right folder" Binding="{Binding Right, Mode=OneWay}" Width="*" MinWidth="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Add pair…" Style="{StaticResource PrimaryButton}" Click="AddPair_Click"/>
                                <Button Content="Edit" Click="EditPair_Click"/>
                                <Button Content="Remove" Click="RemovePair_Click"/>
                                <Button Content="Open config file" Style="{StaticResource LinkButton}" Click="OpenConfig_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="RecycleNote" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0"
                                       Text="Double-click a pair to edit it. Two-way merges both folders and never deletes; one-directional pairs can optionally mirror, which does delete."/>
                        </StackPanel>
                    </Border>

                    <!-- Skip lists -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Skip" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Files" Margin="0,0,12,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SkipFilesBox" Margin="0,0,0,8"
                                         LostFocus="Skip_LostFocus"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Folders" Margin="0,0,12,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SkipFoldersBox" LostFocus="Skip_LostFocus"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0"
                                       Text="Separate with ; or , — wildcards allowed (e.g. ~$*, *.tmp)."/>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SyncButton" Style="{StaticResource PrimaryButton}"
                                        Content="Sync now" Click="Sync_Click"/>
                                <Button x:Name="PreviewButton" Content="Preview" Click="Preview_Click"/>
                                <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click"/>
                                <Button Content="Check health" Click="Health_Click"/>
                                <Button Content="Open logs" Style="{StaticResource LinkButton}" Click="OpenLogs_Click"/>
                            </StackPanel>
                            <ProgressBar x:Name="Progress" Margin="0,16,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                            <TextBlock x:Name="StatusText" Margin="0,12,0,0" Text="Ready."/>
                        </StackPanel>
                    </Border>

                    <!-- Last sync -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Last sync" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="LastRunText" Text="No sync recorded yet."/>
                            <DataGrid x:Name="LastRunGrid" Margin="0,12,0,0" MaxHeight="180"
                                      Visibility="Collapsed" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Destination" Binding="{Binding Name, Mode=OneWay}" Width="150"/>
                                    <DataGridTextColumn Header="Result" Binding="{Binding ResultText, Mode=OneWay}" Width="110"/>
                                    <DataGridTextColumn Header="Copied" Binding="{Binding FilesCopied, Mode=OneWay}" Width="70"/>
                                    <DataGridTextColumn Header="Failed" Binding="{Binding FilesFailed, Mode=OneWay}" Width="70"/>
                                    <DataGridTextColumn Header="Recycled" Binding="{Binding FilesRecycled, Mode=OneWay}" Width="75"/>
                                    <DataGridTextColumn Header="Kept" Binding="{Binding FilesBackedUp, Mode=OneWay}" Width="60"
                                                        ToolTipService.ToolTip="Previous versions kept when a newer copy replaced them"/>
                                    <DataGridTextColumn Header="Folder" Binding="{Binding Destination}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ PAGE: Schedule ============ -->
                <StackPanel x:Name="PageSchedule" Visibility="Collapsed">
                    <TextBlock Text="Schedule" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,18"
                               Text="Windows Task Scheduler runs the sync for you. No admin rights required."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel x:Name="ScheduleRows"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,10,0,0"
                                       Text="Times use the 24-hour clock. Changing a time takes effect when you press Enable again."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Logon and unlock" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="UnlockNote" Style="{StaticResource Subtle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ PAGE: Notifications ============ -->
                <StackPanel x:Name="PageEmail" Visibility="Collapsed">
                    <TextBlock Text="Notifications" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,18"
                               Text="Email a summary after each scheduled sync, with the run's log attached."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="EmailEnable" Content="Send email after each scheduled sync"
                                      Click="EmailEnable_Click"/>
                            <StackPanel x:Name="EmailFields" Margin="0,16,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="From" Margin="0,0,14,10"/>
                                    <TextBox  Grid.Row="0" Grid.Column="1" x:Name="EmailFrom" Margin="0,0,0,10"
                                              LostFocus="Email_LostFocus"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="App password" Margin="0,0,14,10"/>
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- PasswordBox has no placeholder, so an overlay shows
                                             whether a password is already stored. -->
                                        <Grid Grid.Column="0">
                                            <PasswordBox x:Name="EmailPassword" LostFocus="Email_LostFocus"
                                                         PasswordChanged="EmailPassword_Changed"/>
                                            <TextBlock x:Name="EmailPasswordHint" IsHitTestVisible="False"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource FgMuted}"/>
                                        </Grid>
                                        <Button Grid.Column="1" Content="How?" Style="{StaticResource LinkButton}"
                                                Margin="8,0,0,0" Click="AppPasswordHelp_Click"/>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Send to" Margin="0,0,14,10"/>
                                    <TextBox  Grid.Row="2" Grid.Column="1" x:Name="EmailTo" Margin="0,0,0,10"
                                              LostFocus="Email_LostFocus"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="SMTP" Margin="0,0,14,10"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBox x:Name="EmailHost" Width="220" LostFocus="Email_LostFocus"/>
                                        <TextBlock Text="Port" Margin="12,0,8,0"/>
                                        <TextBox x:Name="EmailPort" Width="70" LostFocus="Email_LostFocus"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="When" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="EmailModeBox" Width="170" SelectionChanged="EmailMode_Changed">
                                            <ComboBoxItem Content="Always"/>
                                            <ComboBoxItem Content="Only on errors"/>
                                            <ComboBoxItem Content="Only on success"/>
                                        </ComboBox>
                                        <Button Content="Send test email" Margin="12,0,0,0" Click="SendTest_Click"/>
                                        <TextBlock x:Name="EmailStatus" Margin="12,0,0,0" Style="{StaticResource Subtle}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Subtle}" Margin="0,14,0,0"
                                           Text="Gmail needs a 16-character App Password, not your normal password. The password is stored encrypted for your Windows account."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ PAGE: Recycled files ============ -->
                <StackPanel x:Name="PageRecycled" Visibility="Collapsed">
                    <TextBlock Text="Recycled files" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,18"
                               Text="When a mirror would delete something, it is moved here instead. Restore puts files back into the source folder, so the next sync copies them everywhere again."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Batches" Style="{StaticResource CardTitle}" Margin="0,0,12,0"/>
                                <Button Content="Refresh" Style="{StaticResource LinkButton}" Click="RefreshRecycled_Click"/>
                            </StackPanel>
                            <DataGrid x:Name="BatchGrid" MinHeight="110" MaxHeight="200" IsReadOnly="True"
                                      SelectionChanged="BatchGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When" Binding="{Binding WhenText, Mode=OneWay}" Width="145"/>
                                    <DataGridTextColumn Header="Why" Binding="{Binding ReasonText, Mode=OneWay}" Width="160"/>
                                    <DataGridTextColumn Header="Destination" Binding="{Binding DestinationName, Mode=OneWay}" Width="140"/>
                                    <DataGridTextColumn Header="Files" Binding="{Binding FileCount, Mode=OneWay}" Width="60"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="80"/>
                                    <DataGridTextColumn Header="Folder" Binding="{Binding Path, Mode=OneWay}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="RecycledFilesTitle" Text="Files" Style="{StaticResource CardTitle}"/>
                            <!-- Says what restoring this particular batch would do: recovering a
                                 deleted file and rolling back a replaced one are different acts. -->
                            <TextBlock x:Name="RestoreMeaningText" Style="{StaticResource Subtle}"
                                       Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <DataGrid x:Name="RecycledFileGrid" MinHeight="140" MaxHeight="260" IsReadOnly="True"
                                      SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File" Binding="{Binding RelativePath, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="90"/>
                                    <DataGridTextColumn Header="Modified" Binding="{Binding Modified, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="RestoreSelectedButton" Style="{StaticResource PrimaryButton}"
                                        Content="Restore selected" Click="RestoreSelected_Click"/>
                                <Button x:Name="RestoreAllButton" Content="Restore all in batch" Click="RestoreAll_Click"/>
                                <Button Content="Open folder" Style="{StaticResource LinkButton}" Click="OpenBatchFolder_Click"/>
                                <Button x:Name="DeleteBatchButton" Style="{StaticResource DangerButton}"
                                        Content="Delete batch" Click="DeleteBatch_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="RestoreStatus" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ PAGE: About ============ -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="About" Style="{StaticResource H1}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="AboutVersion" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Subtle}"
                                       Text="Mirrors one folder into several local cloud-sync folders or backup drives, using robocopy for transfers and Windows Task Scheduler for automation."/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Check for updates" Click="CheckUpdates_Click"/>
                                <Button Content="Open project page" Style="{StaticResource LinkButton}" Click="OpenProject_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Subtle}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Developer / copyright -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Developer" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Developed by" Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Bhoomil Kalyani" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Contact" Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Padding="0,0,0,8" Margin="0"
                                        Content="bhoomil.kalyani999@gmail.com" Click="EmailDeveloper_Click"
                                        ToolTip="Send an email"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Source" Style="{StaticResource Subtle}"/>
                                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Padding="0" Margin="0"
                                        Content="github.com/BhoomilKalyani/FolderSync" Click="OpenProject_Click"/>
                            </Grid>

                            <Separator/>
                            <TextBlock x:Name="CopyrightText" Style="{StaticResource Subtle}"/>
                            <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0"
                                       Text="Released under the MIT Licence. Provided as is, without warranty of any kind."/>
                            <Button Content="View licence" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="ViewLicence_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Where things live on disk -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Folders" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="AboutPaths" Style="{StaticResource Subtle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
