<Window x:Class="FolderSync.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="860" MinHeight="320" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="16">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" Style="{StaticResource CardTitle}"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copy" Click="Copy_Click"/>
            <Button Content="Close" Style="{StaticResource PrimaryButton}" Click="Close_Click" Margin="0"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0" Padding="2">
            <TextBox x:Name="Body" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" VerticalContentAlignment="Top" Padding="10"/>
        </Border>
    </DockPanel>
</Window>
